# Leave empty to use the built-in local query mode.
COPILOT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Alternatively use COPILOT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternatively use COPILOT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional existing PostgreSQL connection, e.g. a private Supabase database.
DATABASE_URL=

